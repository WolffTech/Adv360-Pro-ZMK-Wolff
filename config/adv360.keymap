#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        rpi: require_prior_idle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1               &kp N2               &kp N3           &kp N4             &kp N5  &none                                                                                &none                  &kp N6  &kp N7              &kp N8            &kp N9                &kp N0                   &kp BACKSPACE
&kp TAB    &kp Q                &kp W                &kp E            &kp R              &kp T   &none                                                                                &none                  &kp Y   &kp U               &kp I             &kp O                 &kp P                    &kp BSLH
&kp ESC    &rpi LEFT_COMMAND A  &rpi LEFT_CONTROL S  &rpi LEFT_ALT D  &rpi LEFT_SHIFT F  &kp G   &kp LEFT_PARENTHESIS  &kp LCTRL  &mo 3                 &kp LG(SPACE)      &kp RCTRL  &kp RIGHT_PARENTHESIS  &kp H   &rpi RIGHT_SHIFT J  &rpi RIGHT_ALT K  &rpi RIGHT_CONTROL L  &rpi RIGHT_COMMAND SEMI  &kp SQT
&kp LSHFT  &kp Z                &kp X                &kp C            &kp V              &kp B                                    &kp LEFT_ALT          &kp RIGHT_ALT                                        &kp N   &kp M               &kp COMMA         &kp DOT               &kp FSLH                 &kp ENTER
&none      &none                &kp LEFT_CONTROL     &kp LEFT_ALT     &kp LEFT_COMMAND           &kp BSPC              &mo 1      &kp LEFT_COMMAND      &kp RIGHT_COMMAND  &mo 2      &kp SPACE                      &kp LEFT            &kp DOWN          &kp UP                &kp RIGHT                &none
            >;
        };

        upper_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans          &trans          &trans        &trans           &trans          &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans                                      &trans  &kp N6          &kp N7          &kp N8        &kp N9           &kp N0          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_UP    &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans          &mkp LCLK       &mkp RCLK     &mkp MCLK        &msc SCRL_DOWN  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &mo 3   &trans                  &trans          &trans        &trans           &trans          &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp F1  &kp F2     &kp F3            &kp F4          &kp F5                &kp F6       &trans                                      &trans  &kp F7           &kp F8                 &kp F9           &kp F10            &kp F11    &kp F12
&trans  &trans     &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp TILDE    &none                                       &none   &kp CARET        &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GRAVE  &trans
&trans  &kp MINUS  &kp STAR          &kp EQUAL       &kp UNDER             &kp DOLLAR   &none   &trans  &trans      &trans  &trans  &none   &kp LEFT         &kp DOWN               &kp UP_ARROW     &kp RIGHT          &kp POUND  &trans
&trans  &kp PLUS   &kp PIPE          &kp AT          &kp SLASH             &kp PERCENT                  &trans      &trans                  &kp EXCLAMATION  &kp BACKSLASH          &kp AMPERSAND    &kp QUESTION       &kp EXCL   &trans
&trans  &trans     &trans            &trans          &trans                             &trans  &mo 3   &trans      &trans  &trans  &trans                   &trans                 &trans           &trans             &trans     &trans
            >;
        };

        command_layer {
            display-name = "Comm";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none           &none              &none            &none       &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none           &none              &none            &none       &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none           &kp K_PLAY_PAUSE   &none            &none       &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                  &bl BL_INC         &bl BL_DEC       &none       &none  &none
            >;
        };
    };
};
